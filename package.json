{
  "name": "bedex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @bedex/api --filter @bedex/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @bedex/db generate",
    "db:migrate": "pnpm --filter @bedex/db migrate",
    "db:seed": "pnpm --filter @bedex/db seed",
    "db:seed:demo": "pnpm --filter @bedex/db seed:demo",
    "db:studio": "pnpm --filter @bedex/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0"
  }
}
