# Copy to .env at the repo root. Never commit real values.

# --- Docker deployment only (docker-compose.yml) ---
# The public HTTPS address of the site; Caddy gets its certificate for this host.
PUBLIC_URL=

# --- API ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Supabase Postgres connection string. Use the *Session* pooler (port 5432):
# the live dashboard relies on LISTEN/NOTIFY, which the transaction pooler (6543) drops.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bedex
# Connections per API process. Supabase's session pooler allows ~15 clients in
# total across everything (API processes, migrations, Studio), so keep this low.
DATABASE_POOL_MAX=5
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Set to false only for local http development
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=1

# --- Supabase Storage (backend only). Project Settings → API: URL + service_role / secret key ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for proof-of-delivery photos (DRP-05)
SUPABASE_PHOTO_BUCKET=delivery-photos

# --- Google Maps Platform (all optional; without them the planner uses estimates) ---
# Server key for the Routes API (road travel times/ETAs). Restrict it by server IP.
GOOGLE_MAPS_SERVER_KEY=
# Route Optimization API needs OAuth, not an API key: a service account with the
# "Route Optimization Editor" role. Paste its JSON key on one line, or base64 it.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Seed (first admin user) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# --- Web (Vite; exposed to the browser) ---
# Browser key: restrict by HTTP referrer, Maps JavaScript API only
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Map ID for advanced markers (Cloud console → Map Management). Blank = Google's DEMO_MAP_ID (dev only)
VITE_GOOGLE_MAPS_MAP_ID=
# Leave empty to use the /api/v1 dev proxy
VITE_API_URL=
