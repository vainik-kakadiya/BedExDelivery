# Copy to .env at the repo root. Never commit real values.

# --- API ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Supabase Postgres connection string. Use the *Session* pooler (port 5432):
# the live dashboard relies on LISTEN/NOTIFY, which the transaction pooler (6543) drops.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bedex
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Set to false only for local http development
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Nginx = 1)
TRUST_PROXY=1

# --- Supabase (storage / realtime, backend only) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps Platform ---
# Server key: restrict by IP (Routes, Route Optimization, Geocoding)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_CLOUD_PROJECT_ID=

# --- Seed (first admin user) ---
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# --- Web (Vite; exposed to the browser) ---
# Browser key: restrict by HTTP referrer, Maps JavaScript API only
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Map ID for advanced markers (Cloud console → Map Management). Blank = Google's DEMO_MAP_ID (dev only)
VITE_GOOGLE_MAPS_MAP_ID=
# Leave empty to use the /api/v1 dev proxy
VITE_API_URL=
